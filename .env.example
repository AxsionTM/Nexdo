# ==================== Database ====================
DATABASE_URL="postgresql://ticktick:ticktick_secret@localhost:5432/ticktick?schema=public"

# ==================== Redis ====================
REDIS_URL="redis://localhost:6379"

# ==================== Auth (NextAuth / Auth.js) ====================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ==================== JWT ====================
JWT_SECRET="change-me-to-another-long-random-string"

# ==================== MinIO / S3 ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ticktick-attachments
MINIO_USE_SSL=false

# ==================== API ====================
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ==================== AI Service ====================
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=  # optional, for advanced AI features

# ==================== App ====================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="TickTick Clone"
NEXT_PUBLIC_DEFAULT_LOCALE=ru
